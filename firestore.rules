rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /requests/{requestId} {
      
      // Because the entire architecture has shifted to a Vercel Proxy backend to bypass Wi-Fi DPIs,
      // all Firebase reads/writes are channeled exclusively through the authenticated Vercel Node runtime.
      
      // We can completely lock down the client SDK, permanently fixing the security loophole
      // (a student authenticating anonymously and manually submitting an UPDATE flag).

      // ONLY authenticated staff running inside the stealth Vercel backend proxy can mutate or list
      allow create, update, delete, list: if request.auth != null && request.auth.token.email == 'staff@amrita.edu';
      
      // The single track request endpoint can still query directly by ID if needed (though proxied as well)
      allow get: if true;
    }
  }
}